{
  "name": "soundshed",
  "version": "1.3.0",
  "description": "Browse and manage favourite tones, preview or store on your amp. Jam to Backing tracks and Lessons",
  "main": "./build/main.js",
  "repository": "https://github.com/soundshed/soundshed-app",
  "private": true,
  "engines": {
    "node": "^24.13.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "build-web": "tsc && webpack --config ./webpack.web.config.js",
    "build-electron": "tsc && webpack --config ./webpack.electron.config.js",
    "build-tools": "tsc -p tsconfig.tools.json",
    "sim:spark": "node build-tools/tools/spark-amp-simulator/src/cli.js",
    "sim:spark:build": "npm run build-tools && npm run sim:spark",
    "sim:spark:help": "npm run sim:spark -- help",
    "sim:spark:ble": "npm run sim:spark -- --transport ble",
    "sim:spark:both": "npm run sim:spark -- --transport both",
    "sim:spark:test": "tsc && npm run build-tools && node build-tools/tools/spark-amp-simulator/src/tcpIntegrationTest.js",
    "sim:spark:test:quick": "npm run build-tools && node build-tools/tools/spark-amp-simulator/src/tcpIntegrationTest.js",
    "watch-web": "concurrently \"tsc -w\" \"webpack -w --config ./webpack.web.config.js\"",
    "watch-electron": "concurrently \"tsc -w\" \"webpack -w --config ./webpack.electron.config.js\"",
    "start-electron": "npm run build-electron && electron-forge start --inspect-electron",
    "test": "npm run sim:spark:test",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "author": "Webprofusion",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@stoprocent/bleno": "^0.13.1",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-bluetooth": "^0.0.21",
    "@yaireo/tagify": "^4.39.0",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "electron": "^44.5.1",
    "fs-extra": "^11.4.1",
    "html-webpack-plugin": "^5.6.8",
    "jwt-decode": "^4.0.0",
    "log-update": "^8.0.0",
    "node-gyp": "^13.1.0",
    "node-loader": "^2.1.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "path-browserify": "^1.0.1",
    "pullstate": "^1.25.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.7.2",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.4",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "webmidi": "^3.3.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "youtube-search": "^1.1.6"
  },
  "dependencies": {
    "update-electron-app": "^3.3.0"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "overrides": {
    "axios": "^1.20.0",
    "xml2js": "^0.6.2"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "@stoprocent/bleno@0.13.1": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "electron-winstaller@5.4.0": true,
    "usb@2.18.0": true
  }
}
